# Matches docker-compose.yml (host port 5434, so it does not clash with a local PostgreSQL on 5432 or 5433)
DATABASE_URL="postgresql://slotsync:slotsync@localhost:5434/slotsync?schema=public"

# Used by Auth.js to sign session cookies. Generate with: npx auth secret
AUTH_SECRET="replace-with-output-of-npx-auth-secret"
